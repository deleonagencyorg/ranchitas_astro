---
import { resolveGtmId } from '../../config/gtm';

interface Props {
  part?: 'all' | 'script' | 'noscript';
}

const { part = 'all' } = Astro.props;
const gtmId = resolveGtmId(import.meta.env.PUBLIC_GTM_ID);
const showScript = part === 'all' || part === 'script';
const showNoscript = part === 'all' || part === 'noscript';
---

{showNoscript && (
  <noscript>
    <iframe
      src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
      height="0"
      width="0"
      style="display:none;visibility:hidden"
    ></iframe>
  </noscript>
)}

{showScript && (
  <script is:inline define:vars={{ gtmId }} data-astro-rerun>
    (function () {
      var id = gtmId;
      if (!id) return;

      function ensureGtm() {
        window.dataLayer = window.dataLayer || [];
        var runtime = window.google_tag_manager && window.google_tag_manager[id];
        if (runtime) return;
        if (document.querySelector('script[data-gtm-loader="' + id + '"]')) return;

        window.dataLayer.push({
          'gtm.start': new Date().getTime(),
          event: 'gtm.js',
        });

        var script = document.createElement('script');
        script.async = true;
        script.src = 'https://www.googletagmanager.com/gtm.js?id=' + id;
        script.setAttribute('data-gtm-loader', id);

        var parent = document.head || document.body || document.documentElement;
        try {
          parent.appendChild(script);
        } catch {
          document.documentElement.appendChild(script);
        }
      }

      function onPageLoad() {
        ensureGtm();
        var path = location.pathname + location.search;
        if (window.__ranchitasGtmPath === path) return;
        var hadPath = typeof window.__ranchitasGtmPath === 'string';
        window.__ranchitasGtmPath = path;
        if (!hadPath) return;
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          event: 'page_view',
          page_path: path,
          page_location: location.href,
          page_title: document.title,
        });
      }

      if (!window.__ranchitasGtmBound) {
        window.__ranchitasGtmBound = true;
        document.addEventListener('astro:page-load', onPageLoad);
      }

      onPageLoad();
    })();
  </script>
)}
