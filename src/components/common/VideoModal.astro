---
// src/components/common/VideoModal.astro
interface Props {
  id?: string;
}

const { id = 'videoModal' } = Astro.props;
---

<div id={id} class="fixed inset-0 z-[2147483647] hidden" aria-hidden="true">
  <div class="absolute inset-0 bg-black/80 backdrop-blur-sm" data-video-backdrop></div>

  <div class="absolute inset-0 flex items-center justify-center p-4 md:p-6">
    <div id="modal-content" class="relative w-full max-w-5xl">
      <button
        type="button"
        id="close-btn"
        class="absolute -top-2 right-0 md:top-0 md:-right-14 z-[2150000000] w-11 h-11 rounded-full bg-black/70 hover:bg-black/90 text-white flex items-center justify-center transition-all"
        aria-label="Cerrar video"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 6 6 18" />
          <path d="M6 6 18 18" />
        </svg>
      </button>

      <div id={`${id}-youtube`} class="hidden w-full aspect-video bg-black rounded-[20px] overflow-hidden shadow-2xl">
        <iframe
          id={`${id}-iframe`}
          class="w-full h-full"
          src=""
          title="YouTube video player"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        ></iframe>
      </div>

      <div id={`${id}-file`} class="hidden w-full flex items-center justify-center">
        <div
          id={`${id}-file-frame`}
          class="relative overflow-hidden rounded-[20px] bg-black shadow-2xl"
        >
          <video
            id={`${id}-player`}
            class="block w-full h-full"
            controls
            playsinline
            preload="metadata"
          ></video>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const YOUTUBE_HOSTS = new Set(['youtube', 'yt']);

    function resolveVideoHost(videoUrl, host) {
      const normalizedHost = String(host || '').trim().toLowerCase();

      if (normalizedHost) {
        return YOUTUBE_HOSTS.has(normalizedHost) ? 'youtube' : 'file';
      }

      const url = String(videoUrl || '').toLowerCase();
      if (
        url.includes('youtube.com') ||
        url.includes('youtu.be') ||
        url.includes('youtube-nocookie.com')
      ) {
        return 'youtube';
      }

      return 'file';
    }

    function toYoutubeEmbedUrl(videoUrl) {
      let embedUrl = videoUrl;

      if (videoUrl.includes('youtube.com/watch?v=')) {
        const videoId = new URL(videoUrl).searchParams.get('v');
        embedUrl = 'https://www.youtube.com/embed/' + videoId + '?autoplay=1';
      } else if (videoUrl.includes('youtu.be/')) {
        const videoId = videoUrl.split('youtu.be/')[1]?.split('?')[0];
        embedUrl = 'https://www.youtube.com/embed/' + videoId + '?autoplay=1';
      } else if (videoUrl.includes('youtube.com/shorts/')) {
        const videoId = videoUrl.split('youtube.com/shorts/')[1]?.split('?')[0];
        embedUrl = 'https://www.youtube.com/embed/' + videoId + '?autoplay=1';
      } else if (videoUrl.includes('youtube.com/embed/')) {
        embedUrl = videoUrl.includes('?') ? videoUrl + '&autoplay=1' : videoUrl + '?autoplay=1';
      }

      return embedUrl;
    }

    function fitVideoFrame(video, frame) {
      const videoWidth = video.videoWidth;
      const videoHeight = video.videoHeight;

      if (!frame || !videoWidth || !videoHeight) return;

      const ratio = videoWidth / videoHeight;
      const maxWidth = Math.min(window.innerWidth * 0.92, 1280);
      const maxHeight = window.innerHeight * 0.9;

      let width = maxWidth;
      let height = width / ratio;

      if (height > maxHeight) {
        height = maxHeight;
        width = height * ratio;
      }

      frame.style.width = Math.round(width) + 'px';
      frame.style.height = Math.round(height) + 'px';
      frame.style.aspectRatio = videoWidth + ' / ' + videoHeight;
    }

    function resetVideoFrame(frame) {
      if (!frame) return;
      frame.style.width = '';
      frame.style.height = '';
      frame.style.aspectRatio = '';
    }

    function initVideoModal() {
      const modal = document.getElementById('videoModal');
      if (!modal) return;

      if (modal.dataset.videoInit === '1') return;
      modal.dataset.videoInit = '1';

      const iframe = document.getElementById('videoModal-iframe');
      const player = document.getElementById('videoModal-player');
      const fileFrame = document.getElementById('videoModal-file-frame');
      const youtubeContainer = document.getElementById('videoModal-youtube');
      const fileContainer = document.getElementById('videoModal-file');
      const modalContent = document.getElementById('modal-content');
      const closeBtn = document.getElementById('close-btn');
      const backdrop = modal.querySelector('[data-video-backdrop]');

      let resizeHandler = null;
      let metadataHandler = null;

      const showYoutube = () => {
        if (modalContent) modalContent.classList.remove('w-fit');
        if (youtubeContainer) youtubeContainer.classList.remove('hidden');
        if (fileContainer) fileContainer.classList.add('hidden');
      };

      const showFile = () => {
        if (modalContent) modalContent.classList.add('w-fit');
        if (youtubeContainer) youtubeContainer.classList.add('hidden');
        if (fileContainer) fileContainer.classList.remove('hidden');
      };

      const detachFileListeners = () => {
        if (resizeHandler) {
          window.removeEventListener('resize', resizeHandler);
          resizeHandler = null;
        }
        if (player && metadataHandler) {
          player.removeEventListener('loadedmetadata', metadataHandler);
          metadataHandler = null;
        }
      };

      const resetPlayers = () => {
        detachFileListeners();
        if (iframe) iframe.src = '';
        if (player) {
          player.pause();
          player.removeAttribute('src');
          while (player.firstChild) player.removeChild(player.firstChild);
        }
        resetVideoFrame(fileFrame);
        if (modalContent) modalContent.classList.remove('w-fit');
        if (youtubeContainer) youtubeContainer.classList.add('hidden');
        if (fileContainer) fileContainer.classList.add('hidden');
      };

      window.openVideoModal = function(videoUrl, videoHost) {
        if (!videoUrl) return;

        const host = resolveVideoHost(videoUrl, videoHost);
        resetPlayers();

        if (host === 'youtube') {
          if (iframe) iframe.src = toYoutubeEmbedUrl(videoUrl);
          showYoutube();
        } else {
          if (player) {
            const applyFrameSize = () => fitVideoFrame(player, fileFrame);

            metadataHandler = applyFrameSize;
            player.addEventListener('loadedmetadata', metadataHandler);

            resizeHandler = applyFrameSize;
            window.addEventListener('resize', resizeHandler);

            player.src = videoUrl;
            player.load();

            if (player.readyState >= 1) {
              applyFrameSize();
            }

            player.play().catch(function () {});
          }
          showFile();
        }

        modal.classList.remove('hidden');
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      };

      const close = () => {
        resetPlayers();
        modal.classList.add('hidden');
        modal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      };

      if (closeBtn) {
        closeBtn.addEventListener('click', close);
      }

      if (backdrop) {
        backdrop.addEventListener('click', close);
      }

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
          close();
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initVideoModal);
    } else {
      initVideoModal();
    }

    document.addEventListener('astro:page-load', initVideoModal);
  })();
</script>
