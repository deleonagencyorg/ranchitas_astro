---
import { button, span } from 'framer-motion/m';

interface CardQuizInterface {
    badge?: string;
    title?: string;
    titleHighlight?: string;
    description1?: string;
    description2?: string;
    videoSrc?: string;
    videoPoster?: string;
    imageSrc?: string;
    backgroundColor?: string;
    titleButton?: string;
}


interface Props {
    cardQuiz: CardQuizInterface;
}

const {
    cardQuiz
} = Astro.props;

const firstSegment = (Astro.url.pathname.split('/')[1] || '').toLowerCase();
const derivedLang = firstSegment === 'en' || firstSegment === 'es' ? firstSegment : 'es';

const mediaSrc = cardQuiz.videoSrc || cardQuiz.imageSrc;
const mediaPoster = cardQuiz.videoPoster;
---

<section data-card-quiz class="hidden md:block xl:block w-full py-6 md:py-12 px-4 md:px-8 xl:-mt-[100px] md:-mt-[90px]">
    <div class="max-w-7xl mx-auto">
        <div
            class="bg-[#0041CD] rounded-[20px] md:rounded-[20px] shadow-xl p-6 md:p-8 xl:p-12"
        >
            <div
                class="flex flex-col xl:flex-row items-center gap-6 md:gap-8 xl:gap-12"
            >
                <!-- image Container -->
                <div class="w-full xl:w-1/2 relative">
                    <div
                        class="rounded-[20px] md:rounded-[20px] flex items-center justify-center shadow-lg overflow-hidden aspect-video relative group"
                        style={`background-color: ${cardQuiz.backgroundColor}`}
                    >
                        <video
                            data-card-quiz-video
                            class="w-full h-full object-cover"
                            src={mediaSrc}
                            poster={mediaPoster}
                            preload="auto"
                            muted
                            loop
                            playsinline
                            autoplay
                        ></video>
                        <button
                            type="button"
                            class="absolute bottom-4 right-4 z-10 flex h-11 w-11 items-center justify-center rounded-full border border-white/20 bg-black/50 text-white shadow-lg backdrop-blur-sm transition hover:bg-black/70"
                            data-card-quiz-toggle
                            aria-label="Activar sonido"
                            data-muted="true"
                        ></button>
                    </div>
                </div>

                <!-- Contenido de texto -->
                <div class="w-full xl:w-1/2 space-y-4 md:space-y-6">
                    <!-- Título con dos colores -->
                    <h1
                        class="text-[49px] font-bold"
                    >
                        <span class="text-white font-heading text-[59px] font-bold leading-none">{cardQuiz.title} </span>
                        <br />
                        <span class="text-white font-heading text-[59px] font-bold leading-none">{cardQuiz.titleHighlight}</span>
                     </h1>

                    <!-- Descripción párrafo 1 -->
                    <p
                        class="text-white text-base md:text-xl xl:text-xl leading-relaxed"
                    >
                        {cardQuiz.description1}
                    </p>

                    <button type="button" onclick="window.openQuizModal && window.openQuizModal()" class="bg-white text-white text-[19px] px-5 py-2 rounded-full font-bold w-full !bg-[#009DDA] inline-flex items-center justify-center hover:opacity-90 transition-opacity">
                        {cardQuiz.titleButton}
                    </button>

                </div>
            </div>
        </div>
    </div>
</section>

<section data-card-quiz class="block md:hidden px-4 py-6 mx-auto max-w-full -mt-[80px]">
    <div class="bg-[#0041CD] rounded-3xl p-4 space-y-4">
        
        <div class="w-full relative">
            <div
            class="rounded-[20px] flex items-center justify-center shadow-lg overflow-hidden h-[240px] sm:h-[280px] relative group"
                style={`background-color: ${cardQuiz.backgroundColor}`}
            >
            <video
                data-card-quiz-video
                class="w-full h-full object-cover"
                src={mediaSrc}
                poster={mediaPoster}
                preload="auto"
                muted
                loop
                playsinline
            ></video>
            <button
                type="button"
                class="absolute bottom-4 right-4 z-10 flex h-10 w-10 items-center justify-center rounded-full border border-white/20 bg-black/50 text-white shadow-lg backdrop-blur-sm transition hover:bg-black/70"
                data-card-quiz-toggle
                aria-label="Activar sonido"
                data-muted="true"
            ></button>
            </div>
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold leading-tight mt-4">
        <span class="text-white">{cardQuiz.title} </span> <br />
        <span class="text-white">{cardQuiz.titleHighlight}</span>
      </h2>
  
      <p class="text-white text-sm sm:text-base leading-relaxed">
        {cardQuiz.description1}
      </p>

      <button type="button" onclick="window.openQuizModal && window.openQuizModal()" class="bg-white text-white text-base sm:text-[19px] px-5 py-2 rounded-full font-bold w-full !bg-[#009DDA] inline-flex items-center justify-center hover:opacity-90 transition-opacity">
        {cardQuiz.titleButton}
    </button>
  
    </div>
</section>

<script>
  const cardQuizObservers = new WeakMap();

  function getMuteIcon(muted: boolean) {
    if (muted) {
      return `
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M11 5 6 9H2v6h4l5 4V5Z"/>
          <path d="M15.5 8.5a5 5 0 0 1 0 7"/>
          <path d="M18.5 6a8.5 8.5 0 0 1 0 12"/>
          <path d="M4 4 20 20"/>
        </svg>`;
    }

    return `
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M11 5 6 9H2v6h4l5 4V5Z"/>
        <path d="M15.5 8.5a5 5 0 0 1 0 7"/>
        <path d="M18.5 6a8.5 8.5 0 0 1 0 12"/>
      </svg>`;
  }

  function setVideoMuteState(video: HTMLVideoElement, button: HTMLButtonElement, muted: boolean) {
    video.muted = muted;
    video.volume = muted ? 0 : 1;
    button.setAttribute('data-muted', String(muted));
    button.setAttribute('aria-label', muted ? 'Activar sonid' : 'Silenciar');
    button.innerHTML = getMuteIcon(muted);
  }

  function initCardQuizVideos() {
    document.querySelectorAll('[data-card-quiz]').forEach((section) => {
      if (cardQuizObservers.has(section)) return;

      const videos = section.querySelectorAll('video[data-card-quiz-video]');
      if (!videos.length) return;

      const toggleButtons = section.querySelectorAll('[data-card-quiz-toggle]');
      toggleButtons.forEach((btn) => {
        const video = (btn.closest('div')?.querySelector('video[data-card-quiz-video]') as HTMLVideoElement | null) || (section.querySelector('video[data-card-quiz-video]') as HTMLVideoElement | null);
        if (!video) return;

        setVideoMuteState(video, btn as HTMLButtonElement, true);

        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          const nextMuted = btn.getAttribute('data-muted') !== 'true';
          setVideoMuteState(video, btn as HTMLButtonElement, nextMuted);
          video.play().catch(() => {});
        });
      });

      const playVideos = () => {
        videos.forEach((video) => {
          const el = video as HTMLVideoElement;
          el.play().catch(() => {
            el.load();
            setTimeout(() => el.play().catch(() => {}), 100);
          });
        });
      };

      const pauseVideos = () => {
        videos.forEach((video) => {
          const el = video as HTMLVideoElement;
          if (!el.paused) el.pause();
        });
      };

      if (!('IntersectionObserver' in window)) {
        playVideos();
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              playVideos();
            } else {
              pauseVideos();
            }
          });
        },
        { threshold: 0.35 }
      );

      observer.observe(section);
      cardQuizObservers.set(section, observer);
    });
  }

  initCardQuizVideos();
  document.addEventListener('astro:page-load', initCardQuizVideos);
  document.addEventListener('astro:after-swap', initCardQuizVideos);
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) {
      setTimeout(initCardQuizVideos, 300);
    }
  });
</script>
  
  
